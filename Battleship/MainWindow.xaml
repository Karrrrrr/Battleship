<Window x:Class="Battleship.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Battleship"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid Background="#FF0B3B6F">
        <Border Width="350" Padding="20" Background="#DD0A2340" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="GameLogo" Source="Resources/Logo.jpg" Width="200" Height="200" Stretch="Uniform" Margin="0,0,0,10" />
                <TextBlock Text="Морской бой" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20" />
                <Button x:Name="StartButton" Content="Начать игру" Width="240" Height="44" Margin="0,0,0,10" />
                <Button x:Name="ExitButton" Content="Выйти" Width="240" Height="44" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
